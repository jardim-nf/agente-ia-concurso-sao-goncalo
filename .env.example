# O "Abrir painel.command" cria o arquivo .env sozinho na primeira vez.
# Se preferir criar à mão, copie este arquivo para .env e preencha.

# Chave da API da Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Opcional: modelo usado pelo Professor IA. Padrão: claude-opus-5-5.
# Para gastar menos: claude-sonnet-5-5 (metade do preço).
# CLAUDE_MODEL=claude-sonnet-5-5

# Só se publicar na Vercel: senha que o navegador precisa informar para usar a IA.
# APP_PASSWORD=
