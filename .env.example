# O "Abrir painel.command" cria o arquivo .env sozinho na primeira vez.
# Se preferir criar à mão, copie este arquivo para .env e preencha UMA das chaves.

# OpenAI (platform.openai.com > API keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ou Anthropic (console.anthropic.com > API Keys)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Se tiver as duas chaves, escolha qual usar: openai ou claude
# AI_PROVIDER=openai

# Só se publicar na Vercel: senha que o navegador precisa informar para usar a IA.
# APP_PASSWORD=
